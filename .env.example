# ---------------------------------------------------------------------------
# A TO Z — Agent Management System
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/atoz_agent_management?schema=public"

# Secret used to sign session cookies (HS256 JWT).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# How long a login session stays valid, in hours. Default: 12
AUTH_SESSION_MAX_AGE_HOURS=12

# Public origin of the deployment. Used for same-origin (CSRF) checks behind
# proxies where the Host header is rewritten. Optional in single-origin setups.
# APP_ORIGIN="https://agents.example.com"

# Credentials created by `npm run db:seed`. Development only — the seed script
# refuses to run with NODE_ENV=production unless SEED_ALLOW_PRODUCTION=true.
# SEED_ADMIN_EMAIL="admin@atoz.local"
# SEED_ADMIN_PASSWORD="ChangeMe!2024"
